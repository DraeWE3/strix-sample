# Neon: Data API + Neon Auth URLs (Neon Console → Data API)
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth

# Neon owner connection string, used only by scripts/ (db:schema, db:admin, db:migrate). Never bundled.
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# EmailJS (contact form)
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Cloudinary (admin uploads, unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Optional: reCAPTCHA v2 site key for the contact form. Set it only together
# with "Enable reCAPTCHA V2 verification" on the EmailJS template.
VITE_RECAPTCHA_SITE_KEY=

# Optional: YouTube video id of the Strix showreel. The showreel button stays
# hidden until it is set.
VITE_SHOWREEL_YOUTUBE_ID=

# Calendly link used by every "Book a call" button on the site
VITE_CALENDLY_URL=https://calendly.com/strix-ryvon/raj-consultation
