{
  "name": "strix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node api.js && vite",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "node api.js && vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:offline": "STRIX_PRERENDER_OFFLINE=1 vite build",
    "lint": "eslint .",
    "test": "node --experimental-test-module-mocks --import ./src/admin/cms/tests/resolveHooks.js --test 'tests/*.test.js' 'src/admin/cms/tests/*.test.js'",
    "test:build": "node --test tests/build/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs dist",
    "verify:admin": "node scripts/verify-release.mjs --admin dist-admin",
    "check": "npm run lint && npm test",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "db:schema": "node --env-file=.env scripts/neon-db.mjs schema",
    "db:admin": "node --env-file=.env scripts/neon-db.mjs add-admin",
    "db:migrate": "node --env-file=.env scripts/migrate-firestore-to-neon.mjs",
    "db:password": "node --env-file=.env scripts/neon-db.mjs set-password"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.9.0-beta",
    "@neondatabase/postgrest-js": "^0.2.0-beta",
    "gsap": "^3.13.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@better-auth/utils": "^0.4.2",
    "@eslint/js": "^9.33.0",
    "@neondatabase/serverless": "^1.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
