rules_version = '2';

// Strix Production — PROPOSED rules. Not deployed by this repository.
// The live rules were not visible during review; compare before replacing.
//
// Safe order (see README → "Firebase security rollout"):
//   1. Create admins/{uid} for each studio user (or set the `admin` custom claim).
//   2. Turn off public sign-up (Authentication → Settings → User actions).
//   3. Deploy the public site build that queries only status == 'published'.
//   4. Test these rules in the emulator / Rules Playground, then deploy them.
//   5. Deploy the studio build (it reads admins/{uid} at sign-in).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // Studio allow-list. Managed in the console only; an admin may check their own entry.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Portfolio cards. Visitors' queries must filter on status == 'published'.
    match /projects/{projectId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /caseStudies/{caseId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();

      // Large sections; readable only while their case study is published.
      match /chunks/{chunkId} {
        allow read: if isAdmin() ||
          get(/databases/$(database)/documents/caseStudies/$(caseId)).data.status == 'published';
        allow write: if isAdmin();
      }
    }

    match /blogs/{blogId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
